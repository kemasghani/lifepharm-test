{% doc %}
  Three short reassurances under the buy button. Empty items are left out.

  @example
  {% content_for 'block', type: 'pdp-assurance', id: 'assurance' %}
{% enddoc %}

<ul class="pdp-assurance" role="list" {{ block.shopify_attributes }}>
  {%- if block.settings.shipping != blank -%}
    <li>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M2.5 6.5h11v10h-11zM13.5 10h4l3.5 3.5v3h-7.5M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
      </svg>
      <span>{{ block.settings.shipping | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.returns != blank -%}
    <li>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M3.5 12a8.5 8.5 0 1 0 2.8-6.3L3.5 8.3M3.5 3.5v4.8h4.8"/>
      </svg>
      <span>{{ block.settings.returns | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.checkout != blank -%}
    <li>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M12 3l7 3v6c0 4.4-3 7.5-7 9-4-1.5-7-4.6-7-9V6zM9 12l2 2 4-4"/>
      </svg>
      <span>{{ block.settings.checkout | escape }}</span>
    </li>
  {%- endif -%}
</ul>

{% stylesheet %}
  .pdp-assurance {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 0.875rem 0 0;
    border-block-start: 1px solid var(--pdp-line, currentColor);
    list-style: none;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .pdp-assurance li {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    justify-items: start;
    min-width: 0;
  }

  .pdp-assurance svg {
    fill: none;
    stroke: var(--pdp-accent, currentColor);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reassurance row",
  "settings": [
    {
      "type": "text",
      "id": "shipping",
      "label": "Shipping",
      "default": "Free shipping over $50"
    },
    {
      "type": "text",
      "id": "returns",
      "label": "Returns",
      "default": "30-day returns"
    },
    {
      "type": "text",
      "id": "checkout",
      "label": "Checkout",
      "default": "Secure checkout"
    }
  ],
  "presets": [
    {
      "name": "Reassurance row"
    }
  ]
}
{% endschema %}
