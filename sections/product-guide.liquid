{%- comment -%}
  Product guide: "How to use", "Key ingredients" and a short FAQ, fed by product
  metafields. Blocks render in editor order. A block with nothing to show renders
  nothing, and the section renders nothing when every block is empty.

  Self-contained on purpose: no theme snippets, classes or CSS variables, so this
  one file moves between themes. Colour and fonts inherit from the page.
{%- endcomment -%}

{%- capture guide_blocks -%}
  {%- for block in section.blocks -%}
    {%- assign block_items = '' -%}

    {%- case block.type -%}
      {%- when 'how_to_use' -%}
        {%- assign block_source = 'custom.how_to_use' -%}
        {%- assign block_tag = 'ol' -%}
        {%- capture block_items -%}
          {%- for step in product.metafields.custom.how_to_use.value -%}
            {%- assign step_text = step | strip -%}
            {%- if step_text != blank -%}
              <li class="product-guide__step">{{ step_text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

      {%- when 'key_ingredients' -%}
        {%- assign block_source = 'custom.key_ingredients' -%}
        {%- assign block_tag = 'ul' -%}
        {%- capture block_items -%}
          {%- for ingredient in product.metafields.custom.key_ingredients.value -%}
            {%- assign ingredient_name = ingredient.name.value | strip -%}
            {%- if ingredient_name != blank -%}
              <li class="product-guide__ingredient">
                {%- assign ingredient_image = ingredient.image.value -%}
                {%- if ingredient_image != blank -%}
                  {{-
                    ingredient_image
                    | image_url: width: 480
                    | image_tag:
                      class: 'product-guide__ingredient-image',
                      loading: 'lazy',
                      widths: '96, 160, 240, 320, 480',
                      sizes: '(min-width: 750px) 240px, 72px',
                      alt: ingredient_name
                  -}}
                {%- endif -%}
                <div class="product-guide__ingredient-text">
                  <h3 class="product-guide__ingredient-name">{{ ingredient_name | escape }}</h3>
                  {%- if ingredient.amount.value != blank -%}
                    <p class="product-guide__ingredient-amount">{{ ingredient.amount.value | escape }}</p>
                  {%- endif -%}
                  {%- if ingredient.summary.value != blank -%}
                    <p class="product-guide__ingredient-summary">{{ ingredient.summary.value | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

      {%- when 'faq' -%}
        {%- assign block_source = 'custom.faqs' -%}
        {%- assign block_tag = 'div' -%}
        {%- assign faq_count = 0 -%}
        {%- capture block_items -%}
          {%- for faq in product.metafields.custom.faqs.value -%}
            {%- assign faq_question = faq.question.value | strip -%}
            {%- assign faq_answer = faq.answer | metafield_tag -%}
            {%- comment -%}
              A rich text field can hold one empty paragraph and still pass
              "!= blank", so test the text that would actually be shown.
            {%- endcomment -%}
            {%- assign faq_answer_text = faq_answer | strip_html | strip -%}
            {%- if faq_question != blank and faq_answer_text != blank -%}
              <details
                class="product-guide__faq"
                name="product-guide-{{ block.id }}"
                {% if faq_count == 0 and block.settings.open_first %}
                  open
                {% endif %}
              >
                <summary class="product-guide__question">{{ faq_question | escape }}</summary>
                <div class="product-guide__answer">{{ faq_answer }}</div>
              </details>
              {%- assign faq_count = faq_count | plus: 1 -%}
              {%- if faq_count >= block.settings.max_items -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
    {%- endcase -%}

    {%- if block_items != blank -%}
      <div
        class="product-guide__block product-guide__block--{{ block.type }}"
        {{ block.shopify_attributes }}
      >
        <h2 class="product-guide__heading">{{ block.settings.heading | escape }}</h2>
        <{{ block_tag }}
          class="product-guide__items"
          {% if block_tag != 'div' %}
            role="list"
          {% endif %}
        >
          {{- block_items -}}
        </{{ block_tag }}>
      </div>
    {%- elsif request.design_mode -%}
      <p class="product-guide__notice" {{ block.shopify_attributes }}>
        "{{ block.settings.heading | escape }}" is hidden on this product because {{ block_source }} has nothing to
        show. Shoppers won't see this note.
      </p>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if guide_blocks != blank -%}
  <div
    class="product-guide product-guide--{{ section.settings.layout }}"
    style="
      --pg-padding-top: {{ section.settings.padding_top }}px;
      --pg-padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.background != blank %}
        --pg-background: {{ section.settings.background }};
      {% endif %}
      {% if section.settings.text != blank %}
        --pg-text: {{ section.settings.text }};
      {% endif %}
    "
  >
    <div class="product-guide__inner">
      {{- guide_blocks -}}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /*
    Sizes use em, not rem. Themes disagree on the root size (Dawn sets it to
    62.5%, so 1rem is 10px there), so everything scales from this section's
    own font size: the theme's body text, but never below 16px.
  */
  .product-guide {
    --pg-gap: clamp(2.5em, 2em + 2.5vw, 4.5em);
    --pg-line: color-mix(in srgb, currentColor 16%, transparent);
    --pg-muted: color-mix(in srgb, currentColor 74%, transparent);

    padding-block: var(--pg-padding-top) var(--pg-padding-bottom);
    background: var(--pg-background, transparent);
    color: var(--pg-text, inherit);
    font-size: max(1em, 16px);
  }

  .product-guide__inner {
    display: grid;
    gap: var(--pg-gap);
    max-width: 75em;
    margin-inline: auto;
    padding-inline: clamp(1.25em, 0.75em + 2.5vw, 3em);
  }

  .product-guide__block {
    display: grid;
    gap: 1.5em clamp(2em, 6vw, 5em);
    min-width: 0;
  }

  .product-guide__block + .product-guide__block,
  .product-guide__notice + .product-guide__block {
    padding-block-start: var(--pg-gap);
    border-block-start: 1px solid var(--pg-line);
  }

  .product-guide__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(1.5em, 1.3em + 1vw, 2.25em);
    line-height: 1.15;
  }

  .product-guide__items {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-guide__block--how_to_use .product-guide__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13em), 1fr));
    gap: 1.5em 2em;
    counter-reset: product-guide-step;
  }

  .product-guide__step {
    padding-block-start: 0.875em;
    border-block-start: 1px solid var(--pg-line);
    font-size: 1em;
    line-height: 1.55;
    counter-increment: product-guide-step;
  }

  .product-guide__step::before {
    display: block;
    margin-block-end: 0.5em;
    color: var(--pg-muted);
    font-size: 0.8125em;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    content: counter(product-guide-step, decimal-leading-zero);
  }

  .product-guide__block--key_ingredients .product-guide__items {
    display: grid;
    gap: 1.25em;
  }

  .product-guide__ingredient {
    display: grid;
    grid-template-columns: 4.5em minmax(0, 1fr);
    gap: 1em;
    align-content: start;
    align-items: start;
  }

  .product-guide__ingredient-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 0.5em;
    object-fit: cover;
  }

  .product-guide__ingredient-text {
    grid-column: 2;
    min-width: 0;
  }

  .product-guide__ingredient-name {
    margin: 0;
    color: inherit;
    font-size: 1.0625em;
    line-height: 1.3;
  }

  .product-guide__ingredient-amount,
  .product-guide__ingredient-summary {
    margin: 0.25em 0 0;
    color: var(--pg-muted);
    font-size: 0.9375em;
    line-height: 1.5;
  }

  .product-guide__ingredient-amount {
    font-variant-numeric: tabular-nums;
  }

  .product-guide__faq {
    border-block-end: 1px solid var(--pg-line);
  }

  .product-guide__faq:first-child {
    border-block-start: 1px solid var(--pg-line);
  }

  .product-guide__question {
    display: flex;
    gap: 1em;
    align-items: center;
    justify-content: space-between;
    min-height: 3em;
    padding-block: 0.8em;
    font-size: 1.0625em;
    font-weight: 500;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }

  .product-guide__question::-webkit-details-marker {
    display: none;
  }

  .product-guide__question:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .product-guide__question::after {
    flex: none;
    width: 0.875em;
    height: 0.875em;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px 100% no-repeat;
    transition: transform 0.2s ease;
    content: '';
  }

  .product-guide__faq[open] > .product-guide__question::after {
    transform: rotate(45deg);
  }

  .product-guide__answer {
    padding-block-end: 1.125em;
    color: var(--pg-muted);
    font-size: 1em;
    line-height: 1.6;
  }

  .product-guide__answer > :first-child {
    margin-block-start: 0;
  }

  .product-guide__answer > :last-child {
    margin-block-end: 0;
  }

  .product-guide__notice {
    margin: 0;
    padding: 1em 1.25em;
    border: 1px dashed var(--pg-line);
    border-radius: 0.5em;
    color: var(--pg-muted);
    font-size: 0.875em;
    line-height: 1.5;
  }

  @supports (interpolate-size: allow-keywords) {
    .product-guide__faq {
      interpolate-size: allow-keywords;
    }

    .product-guide__faq::details-content {
      overflow: clip;
      block-size: 0;
      transition:
        block-size 0.25s ease,
        content-visibility 0.25s allow-discrete;
    }

    .product-guide__faq[open]::details-content {
      block-size: auto;
    }
  }

  @media (min-width: 750px) {
    .product-guide--split .product-guide__block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr);
    }

    .product-guide--split .product-guide__heading {
      position: sticky;
      top: 6em;
      align-self: start;
    }

    .product-guide__block--key_ingredients .product-guide__items {
      grid-template-columns: repeat(auto-fill, minmax(9.5em, 1fr));
      gap: 2em 1.5em;
    }

    .product-guide__ingredient {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-guide__ingredient-text {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-guide__question::after,
    .product-guide__faq::details-content {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product guide",
  "tag": "section",
  "class": "product-guide-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Heading position",
      "options": [
        {
          "value": "split",
          "label": "Beside the content"
        },
        {
          "value": "stacked",
          "label": "Above the content"
        }
      ],
      "default": "split",
      "info": "Always above the content on mobile."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors",
      "info": "Leave these empty to follow the theme."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "how_to_use",
      "name": "How to use",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the steps in the product metafield custom.how_to_use. Hidden when that metafield has no steps."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "How to use"
        }
      ]
    },
    {
      "type": "key_ingredients",
      "name": "Key ingredients",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the ingredient entries in the product metafield custom.key_ingredients. Hidden when none are published."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Key ingredients"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the FAQ entries in the product metafield custom.faqs. Hidden when none have both a question and an answer."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Questions"
        },
        {
          "type": "range",
          "id": "max_items",
          "label": "Maximum questions",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "open_first",
          "label": "Open the first question",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product guide",
      "blocks": [
        {
          "type": "how_to_use"
        },
        {
          "type": "key_ingredients"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
