{% doc %}
  Layout shared by the product page bands: one width and one type size, so every
  band lines up with the Product guide section.

  @example
  {% render 'pdp-band-styles' %}
{% enddoc %}

{% stylesheet %}
  .pdp-band {
    font-size: max(1em, 16px);
  }

  .pdp-band__inner {
    max-width: 75em;
    margin-inline: auto;
    padding-inline: clamp(1.25em, 0.75em + 2.5vw, 3em);
  }

  .pdp-eyebrow {
    margin: 0 0 0.75em;
    color: var(--pdp-accent);
    font-size: 0.8125em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
{% endstylesheet %}
